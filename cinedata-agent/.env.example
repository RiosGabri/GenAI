OPENROUTER_API_KEY=SUA_CHAVE
OPENROUTER_MODEL=openrouter/free
# Opcional: modelos de reserva, separados por vírgula
OPENROUTER_FALLBACK_MODELS=
CINEDATA_DB_PATH=cinerocket.db
# Cada tentativa extra de SQL e a explicação final consomem a cota de 50 req/dia
MAX_SQL_ATTEMPTS=2
NARRATE_ANSWER=true
SHOW_SQL=false
